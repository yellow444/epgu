ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim-bookworm

WORKDIR /app
COPY python-epgu /python-epgu
COPY api-gosuslugi-backend/requirements.txt api-gosuslugi-backend/requirements-test.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip install --no-cache-dir -r requirements-test.txt

# Копируем все модули и все тесты списком по маске. Перечисление по именам
# уже один раз отстало от кода: appeared inbound_api, mailbox, setup_api,
# и образ перестал собирать тесты вообще.
COPY api-gosuslugi-backend/*.py api-gosuslugi-backend/pytest.ini api-gosuslugi-backend/service_profiles.json ./
COPY api-gosuslugi-backend/xml /xml
ENV XML_ROOT=/xml
ENTRYPOINT ["python", "-m", "pytest", "-q"]
