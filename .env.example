# Шаблон переменных окружения. Скопируйте в .env и заполните под свою среду.
# Полное описание - docs/api.md#переменные-окружения и docs/SERVICES.md.

# ---------- Криптография ----------
# GUID API-ключа организации, выпущенный на технологическом портале ЕСИА
apikey=REPLACE_WITH_ORGANIZATION_API_KEY_UUID
# PIN контейнера КриптоПро (в проде - через secrets/Vault, не env)
KeyPin=REPLACE_WITH_KEY_CONTAINER_PIN
# TSA для CAdES-T. Тест: http://testca2012.cryptopro.ru/tsp/tsp.srf
TSAAddress=http://www.cryptopro.ru/tsp/tsp.srf
# Папка с контейнером ключа (xxx.000)
key_folder=./api-gosuslugi-backend/xxx.000
# Провайдер секретов: env (по умолчанию) или master-password.
SECRET_PROVIDER=env

# ---------- Приём входящих запросов ----------
# Порт, который смотрит наружу. Сюда редиректится трафик с внешнего адреса ИС.
# Адреса для регистрации в техпортале: https://<хост>/is и https://<хост>/push
INBOUND_PORT=58080
# Мнемоника ИС из техпортала ЕСИА, показывается на /is и пишется в журнал.
IS_MNEMONIC=
# Внешний адрес системы, только для справки на странице /is.
INBOUND_PUBLIC_URL=
# Предел размера принимаемого тела, байт. Больше - обрежется с пометкой.
INBOUND_MAX_BODY=1048576

# ---------- Отдача Госпочты внешним системам ----------
# Отдельный процесс, читает только том с уже забранными уведомлениями и в ЕПГУ
# не ходит совсем. Пока не задан ни секрет, ни список сетей, данные не
# отдаются: отвечает только /health.
OUTBOUND_PORT=58081
# Секрет в заголовке X-Outbound-Token, только латиницей: openssl rand -hex 32
OUTBOUND_TOKEN=
# Сети потребителей, CIDR через запятую.
OUTBOUND_ALLOW_NETS=
# Сети своего обратного прокси, чьему X-Forwarded-For можно верить.
OUTBOUND_TRUSTED_PROXIES=
OUTBOUND_RATE_PER_MINUTE=60
OUTBOUND_RATE_BURST=20
OUTBOUND_RATE_GLOBAL_PER_MINUTE=600

# ---------- Госпочта (ГЭПС) ----------
# Автоматический забор уведомлений. По умолчанию выключен, и это не
# перестраховка: обращение к ГЭПС равнозначно входу на портал, а с этого
# момента уведомление считается вручённым и идут процессуальные сроки.
# Включается из интерфейса, значение сохраняется в настройках стенда.
GEPS_SCHEDULE_ENABLED=0
# Как часто планировщик просыпается, секунд. Это не частота обращений к ЕПГУ:
# список заказывается раз в сутки, результат забирается по расписанию задачи.
GEPS_SCHEDULE_INTERVAL=900
# Где лежат заявки, уведомления и скачанные вложения.
GEPS_STORE_DIR=./var/epgu-mail/geps
# Счётчик суточных попыток: пять заказов списка и пятнадцать получений.
GEPS_QUOTA_FILE=./var/epgu-mail/geps-quota.json

# ---------- Среды ----------
# ТЕСТ (SVCDEV):
esia_host=https://esia-portal1.test.gosuslugi.ru
svcdev_host=https://svcdev-gostapi.test.gosuslugi.ru
# ПРОД (ГОСТ TLS):
#esia_host=https://esia.gosuslugi.ru
#svcdev_host=https://www.gosuslugi.ru

# ---------- Режим ----------
# Legacy-переключатель уровня логов. Debugpy включается только явным DEBUG=1.
production=

# ---------- Frontend ----------
# Значение встраивается в React bundle при запуске/сборке.
REACT_APP_BACKEND_URL=http://127.0.0.1:55000

# ---------- Безопасность ----------
# CORS allow_origins. Список через запятую или "*".
# В проде укажите конкретный домен фронтенда.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Важно: backend использует process-global токен/сертификат и является
# single-operator приложением. Не публикуйте его без внешней аутентификации.

# ---------- Upstream HTTP timeouts, seconds ----------
UPSTREAM_CONNECT_TIMEOUT=15
UPSTREAM_READ_TIMEOUT=300
UPSTREAM_WRITE_TIMEOUT=300
UPSTREAM_POOL_TIMEOUT=30

# ---------- Каталог услуг ----------
# Строгий JSON overlay code -> profile. Существующий профиль объединяется lossless;
# новый должен содержать полный versioned capability DTO и пройти startup-валидацию.
# Если переменная пустая - используется сгенерированный service_profiles.json.
# Полный каталог - docs/SERVICES.md.
SERVICES=

# Пример безопасного частичного override существующей услуги:
#SERVICES={"60010153":{"title":"Локальное название услуги"}}
