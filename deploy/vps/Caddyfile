# Внешний адрес информационной системы на Caddy. Это то, что стоит на VPS.
#
# Стенд и VPS в разных сетях, прямого пути между ними нет. Стенд сам держит
# обратный SSH-туннель и пробрасывает на VPS порт 58080 на свой приёмник,
# поэтому Caddy ходит на 127.0.0.1:58080. Туннель поднимает сервис tunnel из
# docker-compose.tunnel.yml на стенде.
#
# Этот блок дописывается в существующий /etc/caddy/Caddyfile, глобальные
# настройки и другие сайты не трогаются.
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

smev.mirasnowfox.ru {
	# Наружу открыты только адреса из карточки ИС. Путь для push задаём мы
	# сами, поэтому их три: /is, /push и /message.
	@is path /is /push /message
	handle @is {
		reverse_proxy 127.0.0.1:58080 {
			# Настоящий адрес отправителя. На стенде доверенным прокси должна
			# быть docker-подсеть контейнера-туннеля, иначе в журнале будет
			# виден он, а не ЕПГУ.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Всё остальное наружу не отдаём: операторские методы стенда сюда не
	# проксируются вообще, они слушают localhost на другой машине.
	handle {
		respond 404
	}

	request_body {
		max_size 2MB
	}
}
