ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim-bookworm

WORKDIR /app
COPY python-epgu /python-epgu
COPY api-gosuslugi-backend/requirements.txt api-gosuslugi-backend/requirements-test.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip install --no-cache-dir -r requirements-test.txt

COPY api-gosuslugi-backend/app.py api-gosuslugi-backend/config.py api-gosuslugi-backend/routers.py api-gosuslugi-backend/service_profiles.json ./
COPY api-gosuslugi-backend/xml /xml
COPY api-gosuslugi-backend/test_app.py api-gosuslugi-backend/test_config.py api-gosuslugi-backend/test_submission_contracts.py api-gosuslugi-backend/test_goskey_api.py api-gosuslugi-backend/pytest.ini ./
ENV XML_ROOT=/xml
ENTRYPOINT ["python", "-m", "pytest", "-q"]
