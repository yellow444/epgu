{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ручной маршрут подключения, manual-path.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "provenance", "notice", "warnings", "contours", "link_kinds", "links", "steps", "fields", "letter_template"],
  "properties": {
    "schema_version": { "const": "manual-path.v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "note", "links_availability", "links_verified_at"],
      "allOf": [
        {
          "if": { "properties": { "links_availability": { "const": "verified" } } },
          "then": { "properties": { "links_verified_at": { "type": "string", "format": "date" } } },
          "else": { "properties": { "links_verified_at": { "type": "null" } } }
        }
      ],
      "properties": {
        "origin": { "const": "extracted_from_ui_source" },
        "note": { "type": "string", "minLength": 1 },
        "links_availability": { "enum": ["not_verified", "verified"] },
        "links_verified_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "notice": { "type": "string", "minLength": 1 },
    "warnings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "contours": { "const": ["TEST", "PROD"] },
    "link_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contour", "kind", "label", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "contour": { "enum": ["TEST", "PROD"] },
          "kind": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://[^/@\\s]+(/[^\\s]*)?$" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "action", "collect", "result", "link_kinds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "title": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "collect": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "link_kinds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "hint", "rows"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z]+$" },
          "label": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "rows": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      }
    },
    "letter_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": { "type": "string", "minLength": 1 }
      }
    }
  }
}
