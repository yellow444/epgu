# Внешний адрес информационной системы на Caddy.
#
# Caddy сам получает и продлевает сертификат: имя должно резолвиться на этот
# сервер, а порты 80 и 443 быть открыты.
#
# Стенд и этот VPS соединены существующим VPN: VPS виден со стенда как
# 172.16.10.245, стенд виден с VPS как 172.16.10.246. Поэтому Caddy ходит на
# приёмник прямо по VPN, без SSH-туннеля. VPN этот конфиг не трогает.
#
# Кладётся в /etc/caddy/Caddyfile (или подключается через import).
# После правки: sudo caddy validate --config /etc/caddy/Caddyfile
#              sudo systemctl reload caddy

smev.mirasnowfox.ru {
	# Наружу открыты только адреса из карточки ИС. Путь для push задаём мы
	# сами, поэтому их три: /is, /push и /message. Лишний не мешает,
	# отсутствующий превращается в 404 на стороне Caddy.
	@is path /is /push /message
	handle @is {
		# Адрес стенда в VPN. Если стенд переподключит VPN и получит другой
		# адрес, поправьте здесь; чтобы адрес не менялся, закрепите его на
		# VPN-сервере (в OpenVPN это ccd с ifconfig-push для этого клиента).
		reverse_proxy 172.16.10.246:58080 {
			# Настоящий адрес отправителя. На стенде этот адрес VPN-сервера
			# должен быть в INBOUND_TRUSTED_PROXIES, иначе в журнале будет
			# виден VPN-шлюз, а не ЕПГУ.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Всё остальное наружу не отдаём: операторские методы стенда сюда не
	# проксируются вообще, они слушают localhost на другой машине.
	handle {
		respond 404
	}

	request_body {
		max_size 2MB
	}

	log {
		output file /var/log/caddy/smev.log
	}
}
