server {
    listen       80;
    server_name  _;
    root /usr/share/nginx/html;
    index index.html index.htm;
    expires off;
    server_tokens off;

    # The production bundle talks to the backend through the same-origin /api
    # proxy. Ant Design/Ace currently require inline styles; scripts remain
    # restricted to files served by this nginx instance.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Frontend передаёт исходный комплект backend-у целиком; backend уже затем
    # применяет лимит 50 MB к каждому upstream chunk. Ограничение здесь защищает
    # локальный single-operator стенд от неограниченных тел.
    client_max_body_size 64m;
    # Обработка запросов к статическим файлам (фронтенд)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Проксирование запросов к API на backend
    location /api/ {
        # Здесь переменная BACKEND_API должна быть подставлена, например, через entrypoint
        # Завершающий slash снимает внешний префикс /api/ перед FastAPI.
        proxy_pass ${BACKEND_API}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Важно: сохраняем метод запроса (POST, GET и т.д.)
        proxy_method $request_method;
        # Убираем ограничения для больших тел запросов
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
